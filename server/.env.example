# Copy this file to .env and fill in your values.
#   cp .env.example .env
# NEVER commit the real .env file to git.

# Your Google AI Studio Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: which Gemini model to use
GEMINI_MODEL=gemini-2.0-flash

# Optional: port for the server (default 3000)
PORT=3000
